# Auto detect text files and perform LF normalization
* text=auto

# Binary assets (committed directly into Git, not LFS, so Vercel serves valid binaries)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
